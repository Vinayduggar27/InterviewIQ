generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  password       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  avatar         String?
  university     String?
  course         String?
  github         String?
  linkedin       String?
  experience     String?
  role           String?
  skills         String?

  interviews     Interview[]
  resumeAnalyses ResumeAnalysis[]
}

model Interview {
  id                 String    @id @default(cuid())
  role               String
  company            String
  experience         Int
  techStack          String
  questions          Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  userId             String
  answers            Json?
  communicationScore Int?
  completedAt        DateTime?
  confidenceScore    Int?
  feedback           String?
  overallScore       Int?
  strengths          Json?
  technicalScore     Int?
  weaknesses         Json?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResumeAnalysis {
  id              String   @id @default(cuid())
  userId          String
  atsScore        Int
  strengths       Json
  weaknesses      Json
  missingKeywords Json
  suggestions     Json
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
